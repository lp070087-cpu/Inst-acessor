{
  "name": "inst-acessor",
  "version": "0.1.0",
  "private": true,
  "description": "Inst Acessor — inteligência para o crescimento do seu Instagram",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node bench/demo-dev.mjs",
    "test:demo": "node bench/test-demo-policy.mjs && node bench/test-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test:offline": "node bench/safe-run.mjs offline",
    "test:integration": "node bench/safe-run.mjs integration",
    "verify:types": "node bench/safe-run.mjs typecheck",
    "verify:lint": "node bench/safe-run.mjs lint",
    "verify:schema": "node bench/safe-run.mjs schema",
    "verify:build": "node bench/safe-run.mjs build"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.7",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "source-map-js": "^1.2.2",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
