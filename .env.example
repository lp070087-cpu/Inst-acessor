# ============================================================
# INST ACESSOR — Variáveis de ambiente
# ------------------------------------------------------------
# 1) Copie este arquivo para `.env.local`
# 2) Preencha os valores reais
# 3) NUNCA envie `.env.local` para o Git
# ============================================================

# --- Banco de dados (Neon PostgreSQL) ------------------------
# Crie um projeto em https://neon.tech e copie a connection string.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-seu-projeto.us-east-2.aws.neon.tech/inst-acessor?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-seu-projeto.us-east-2.aws.neon.tech/inst-acessor?sslmode=require"

# --- Autenticação (Auth.js / NextAuth) ------------------------
# Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Aliases compatíveis next-auth v4 (defina os MESMOS valores):
#   NEXTAUTH_SECRET="<mesmo valor do AUTH_SECRET>"
#   NEXTAUTH_URL="<mesma URL do AUTH_URL>"

# --- Administração (OPCIONAL) ----------------------------------
# O administrador é SEMPRE lp070087@gmail.com (regra oficial no código).
# ADMIN_EMAIL é um complemento OPCIONAL de ambiente — ele NUNCA substitui
# nem cria um segundo administrador por si só. Se definido, apenas adiciona
# um e-mail adicional à lista de autorizados (a role no banco nunca concede
# privilégio administrativo). Deixe vazio para manter só o e-mail oficial.
ADMIN_EMAIL=""

# --- E-mail (prova de posse do primeiro acesso) ----------------
# Provider desacoplado (decisão EXTERNA pendente — a DONA escolhe e configura).
# SEM provider configurado, o link de primeiro acesso é registrado no banco,
# mas o envio real NÃO acontece (nunca fingimos envio). Em desenvolvimento,
# o link é exibido na tela para teste do fluxo.
EMAIL_PROVIDER=""
# Ex.: "resend" | "sendgrid" | "ses" | "mailgun" | "brevo"
# Chaves específicas do provider escolhido (adicionar conforme decisão):
#   RESEND_API_KEY=""
#   SENDGRID_API_KEY=""
#   AWS_SES_*=""
#   MAILGUN_API_KEY=""
#   BREVO_API_KEY=""

# --- Meta (Instagram) — conexão real --------------------------
# App criado na Meta Developers ("Inst acessor").
# A UI do SaaS mostra APENAS "Conectar Instagram"; a autenticação
# da Meta (que usa o app do Facebook como infraestrutura) fica
# oculta no servidor. NUNCA exponha o App Secret no frontend.
META_APP_ID=""
META_APP_SECRET=""

# --- Instagram (Graph API) ------------------------------------
# Em produção, INSTAGRAM_APP_ID/SECRET podem ser os mesmos do app
# Meta. Se o app da Meta for a única fonte, deixe-os iguais.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"
# Versão da Graph API usada no servidor (default: v21.0).
INSTAGRAM_GRAPH_VERSION="v21.0"
# Escopos de permissão solicitados (configuração oficial do produto no
# painel da Meta — conta de teste "fit_unitrix").
INSTAGRAM_SCOPES="instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages"

# --- Criptografia de tokens (AES-256-GCM) ----------------------
# Gere com: openssl rand -hex 32
# NUNCA mude depois de salvar tokens — eles ficariam ilegíveis.
TOKEN_ENCRYPTION_KEY=""

# --- Webhook do Instagram -------------------------------------
# Token de verificação do challenge da Meta (GET /api/webhooks/instagram).
# Escolha um valor forte e configure o MESMO valor no painel da Meta.
# A assinatura dos eventos (POST) usa o App Secret acima
# (META_APP_SECRET / INSTAGRAM_APP_SECRET) — nunca exponha no frontend.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""

# --- TikTok (Graph API) — conexão real -------------------------
# App criado no TikTok Developer Portal.
# A UI do SaaS mostra "Conectar TikTok" e a autenticação acontece
# no servidor. NUNCA crie NEXT_PUBLIC_TIKTOK_CLIENT_SECRET e NUNCA
# exponha o Client Secret no frontend.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/integrations/tiktok/callback"

# --- Webhook do TikTok ----------------------------------------
# Token de verificação do desafio do TikTok (GET /api/webhooks/tiktok).
# Configure o MESMO valor no portal do TikTok.
TIKTOK_WEBHOOK_VERIFY_TOKEN=""

# --- IA (OpenAI / Gemini) --------------------------------------
# Pelo menos UMA chave é necessária para as funcionalidades de IA.
# A chave é usada APENAS no servidor — nunca crie NEXT_PUBLIC_* para ela.
OPENAI_API_KEY=""
# OU (Gemini):
GEMINI_API_KEY=""
# Alias opcional do Gemini (mesma família de API da Google).
GOOGLE_API_KEY=""

# --- Billing (Asaas) — integração real (server-only) ------------
# Chave de API (access_token) do Asaas. Somente no servidor — nunca no
# frontend, nunca no Git, nunca em logs. Vazia = checkout em estado
# controlado (nenhuma cobrança real é feita; UI mostra "não configurado").
ASAAS_API_KEY=""
# URL base do Asaas. Vazia = usa o padrão pelo ambiente:
#   Sandbox  → https://api-sandbox.asaas.com/v3
#   Produção → https://api.asaas.com/v3
ASAAS_BASE_URL=""
# Ambiente usado para escolher a URL padrão e o rótulo no painel:
#   "sandbox" (default) | "production"
ASAAS_ENV="sandbox"
# Meio de cobrança default no checkout:
#   "PIX" (default) | "BOLETO" | "CREDIT_CARD"
ASAAS_BILLING_TYPE="PIX"
# Token que o webhook do Asaas envia para validar a origem dos eventos
# (definido por você no painel Asaas, em Integrações → Webhook). O webhook
# POST /api/webhooks/asaas valida este token (fail-closed: sem token → 503).
ASAAS_WEBHOOK_TOKEN=""
