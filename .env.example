# ============================================================
# INST ACESSOR — Variáveis de ambiente
# ------------------------------------------------------------
# 1) Copie este arquivo para `.env.local`
# 2) Preencha os valores reais
# 3) NUNCA envie `.env.local` para o Git
# ============================================================

# --- Banco de dados (Neon PostgreSQL) ------------------------
# Crie um projeto em https://neon.tech e copie a connection string.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-seu-projeto.us-east-2.aws.neon.tech/inst-acessor?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-seu-projeto.us-east-2.aws.neon.tech/inst-acessor?sslmode=require"

# --- Autenticação (Auth.js / NextAuth) ------------------------
# Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Aliases compatíveis next-auth v4 (defina os MESMOS valores):
#   NEXTAUTH_SECRET="<mesmo valor do AUTH_SECRET>"
#   NEXTAUTH_URL="<mesma URL do AUTH_URL>"
# SITE_URL — domínio público oficial. Em PRODUÇÃO deixe VAZIO (o código usa
# https://unitrixapp.com.br automaticamente). Use apenas em preview/local
# para testar canonical/OG contra um endereço específico.
#   SITE_URL="https://unitrixapp.com.br"

# --- Administração (OPCIONAL) ----------------------------------
# O administrador é SEMPRE lp070087@gmail.com (regra oficial no código).
# ADMIN_EMAIL é um complemento OPCIONAL de ambiente — ele NUNCA substitui
# nem cria um segundo administrador por si só. Se definido, apenas adiciona
# um e-mail adicional à lista de autorizados (a role no banco nunca concede
# privilégio administrativo). Deixe vazio para manter só o e-mail oficial.
ADMIN_EMAIL=""

# --- E-mail (prova de posse do primeiro acesso) ----------------
# Provider desacoplado (decisão EXTERNA pendente — a DONA escolhe e configura).
# SEM provider configurado, o link de primeiro acesso é registrado no banco,
# mas o envio real NÃO acontece (nunca fingimos envio). Em desenvolvimento,
# o link é exibido na tela para teste do fluxo.
EMAIL_PROVIDER=""
# Ex.: "resend" | "sendgrid" | "ses" | "mailgun" | "brevo"
# Remetente verificado do provider (usado em TODOS os envios transacionais).
# Obrigatório quando EMAIL_PROVIDER está configurado. Default usado pelo código:
# "Inst Acessor <nao-responda@unitrixapp.com.br>".
EMAIL_FROM=""
# Chaves específicas do provider escolhido (adicionar conforme decisão):
#   RESEND_API_KEY=""   (Resend — único implementado hoje; API oficial REST)
#   SENDGRID_API_KEY=""
#   AWS_SES_*=""
#   MAILGUN_API_KEY=""
#   BREVO_API_KEY=""

# --- Instagram — Instagram Business Login (conexão real) ------
# App criado na Meta Developers ("Inst Acessor") com o caso de uso
# "Gerenciar mensagens e conteúdo no Instagram".
# O fluxo usado é o INSTAGRAM BUSINESS LOGIN (não é Facebook Login):
# não exige Página do Facebook nem vínculo com Portfólio Empresarial.
# A UI do SaaS mostra APENAS "Conectar Instagram"; a autenticação
# fica oculta no servidor. NUNCA exponha o App Secret no frontend.
#
# PAR PRIORITÁRIO (novo app):
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
#
# COMPATIBILIDADE TEMPORÁRIA — só são usados se INSTAGRAM_APP_* estiver
# vazio. Mantidos apenas para não quebrar ambientes antigos; podem ser
# removidos no futuro. Deixe vazios se INSTAGRAM_APP_* estiver preenchido.
META_APP_ID=""
META_APP_SECRET=""

# URL de redirecionamento — valor EXPLÍCITO e OBRIGATÓRIO.
# O código nunca usa um valor padrão embutido.
# Local (exemplo):
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"
# Produção (Vercel):
#   INSTAGRAM_REDIRECT_URI="https://unitrixapp.com.br/api/integrations/instagram/callback"
# Este MESMO valor deve ser cadastrado no painel da Meta em
# "API do Instagram → Configurar o login da empresa no Instagram → URL de redirecionamento".

# Versão da Graph API usada no servidor (default: v21.0).
INSTAGRAM_GRAPH_VERSION="v21.0"
# Escopos de permissão solicitados.
# DEFAULT do código (usado quando esta variável fica vazia):
#   instagram_business_basic
#   instagram_business_manage_comments
#   instagram_business_manage_messages
#   instagram_business_manage_insights
#   instagram_business_content_publish
# Só defina INSTAGRAM_SCOPES para SOBRESCREVER o default (separado por vírgula).
INSTAGRAM_SCOPES=""

# --- Criptografia de tokens (AES-256-GCM) ----------------------
# Gere com: openssl rand -hex 32
# NUNCA mude depois de salvar tokens — eles ficariam ilegíveis.
TOKEN_ENCRYPTION_KEY=""

# --- Webhook do Instagram -------------------------------------
# Token de verificação do challenge da Meta (GET /api/webhooks/instagram).
# Escolha um valor forte e configure o MESMO valor no painel da Meta.
# A assinatura dos eventos (POST) usa o App Secret acima, na mesma
# prioridade (INSTAGRAM_APP_SECRET → META_APP_SECRET) — nunca exponha
# no frontend.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""

# --- TikTok (Graph API) — conexão real -------------------------
# App criado no TikTok Developer Portal.
# A UI do SaaS mostra "Conectar TikTok" e a autenticação acontece
# no servidor. NUNCA crie NEXT_PUBLIC_TIKTOK_CLIENT_SECRET e NUNCA
# exponha o Client Secret no frontend.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/integrations/tiktok/callback"

# --- Webhook do TikTok ----------------------------------------
# Token de verificação do desafio do TikTok (GET /api/webhooks/tiktok).
# Configure o MESMO valor no portal do TikTok.
TIKTOK_WEBHOOK_VERIFY_TOKEN=""

# --- IA (OpenAI / Gemini) --------------------------------------
# Pelo menos UMA chave é necessária para as funcionalidades de IA.
# A chave é usada APENAS no servidor — nunca crie NEXT_PUBLIC_* para ela.
OPENAI_API_KEY=""
# OU (Gemini):
GEMINI_API_KEY=""
# Alias opcional do Gemini (mesma família de API da Google).
GOOGLE_API_KEY=""

# --- Billing (InfinitePay) — checkout oficial -------------------
# O checkout é feito por LINKS PÚBLICOS do InfinitePay (por plano), já
# conectados nos cards/CTAs — nenhuma chave é necessária para isso.
# As variáveis abaixo são reservadas para a FUTURA integração de
# confirmação de pagamento (API/webhook do InfinitePay) e devem ser
# preenchidas pela DONA quando a integração for contratada. Nada é
# simulado: sem estas variáveis, a liberação de acesso após o pagamento
# do InfinitePay ainda depende de processo manual/documentado.
INFINITEPAY_API_KEY=""
INFINITEPAY_WEBHOOK_TOKEN=""
# Conta InfinitePay (rota pública dos planos) — referência:
#   https://invoice.infinitepay.io/plans/unitrix/...
INFINITEPAY_ACCOUNT_ID="unitrix"

# --- Billing (Asaas) — LEGADO (preservado, descontinuado) --------
# O Asaas NÃO é mais o gateway oficial (InfinitePay assumiu em 2026-08-31).
# O código é preservado como legado: banco/registros/webhook intactos.
# Nenhuma cobrança Asaas nova deve ser iniciada. As variáveis ficam
# documentadas apenas para referência; deixe-as vazias a menos que haja
# migração pendente. NENHUMA aprovação de pagamento é simulada.
ASAAS_API_KEY=""
ASAAS_BASE_URL=""
ASAAS_ENV="sandbox"
ASAAS_BILLING_TYPE="PIX"
ASAAS_WEBHOOK_TOKEN=""
