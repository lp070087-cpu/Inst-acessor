// ============================================================
// INST ACESSOR — Schema Prisma (Fase 1: Fundação)
// ------------------------------------------------------------
// Banco: Neon PostgreSQL
// Fase 1 NÃO integra Instagram/Meta. SocialConnection já está
// preparado para receber a credencial de forma segura na fase
// de integração (token encriptado, sem texto puro).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Usuários
// ------------------------------------------------------------
model User {
  id                     String     @id @default(cuid())
  name                   String?
  email                  String     @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   Role       @default(USER)
  status                 UserStatus @default(ACTIVE)
  // Fase 6.5 (Asaas) — id do cliente no Asaas (NUNCA inventado; preenchido
  // pelo gateway real). Usado para NÃO duplicar customer por usuário.
  asaasCustomerId        String?    @unique
  // Fase "Primeiro Acesso" — o cliente ativa o acesso pelo e-mail da compra,
  // cria a própria senha e conclui o tour. Campos de estado (não duplicam
  // UserProfile.onboardingCompleted, que é o perfil de nicho/objetivo).
  firstAccessCompleted   Boolean    @default(false)
  firstAccessCompletedAt DateTime?
  tourCompleted          Boolean    @default(false)
  tourCompletedAt        DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  preferences           UserPreferences?
  connections           SocialConnection[]
  oauthStates           OAuthState[]
  igProfiles            InstagramProfile[]
  igSnapshots           InstagramSnapshot[]
  igMedias              InstagramMedia[]
  igMediaMetrics        InstagramMediaMetric[]
  tiktokProfiles        TikTokProfile[]
  tiktokSnapshots       TikTokSnapshot[]
  tiktokVideos          TikTokVideo[]
  syncLogs              SyncLog[]
  aiConversations       AIConversation[]
  aiMessages            AIMessage[]
  aiProfile             AIProfile?
  generatedCopies       GeneratedCopy[]
  contentIdeas          ContentIdea[]
  socialDrafts          SocialDraft[]
  mentorshipRecs        MentorshipRecommendation[]
  profileScores         ProfileScore[]
  profileScoreSnapshots ProfileScoreSnapshot[]
  growthExperiments     GrowthExperiment[]
  profileInsights       ProfileInsight[]
  userLevel             UserLevel?
  xpLogs                XpLog[]
  userGoals             UserGoal[]
  userAchievements      UserAchievement[]
  plannedContents       PlannedContent[]
  contentCopyVersions   ContentCopyVersion[]
  subscriptions         Subscription[]
  payments              Payment[]
  billingEvents         BillingEvent[]
  publishQueue          PublishQueue[]
  publishLogs           PublishLog[]
  automationRules       AutomationRule[]
  automationEvents      AutomationEvent[]
  automationExecutions  AutomationExecution[]
  GrowthAction          GrowthAction[]
  accessGrants          AccessGrant[]
  firstAccessTokens     FirstAccessToken[]
  passkeyCredentials    PasskeyCredential[]
}

// ------------------------------------------------------------
// Autenticação externa (Auth.js) — quando aplicável
// ------------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ------------------------------------------------------------
// Sessões (Auth.js)
// ------------------------------------------------------------
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------------
// Perfil público / preferências do usuário
// ------------------------------------------------------------
model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String?
  username            String?
  avatar              String?
  niche               String?
  subNiche            String?
  objective           String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Preferências do usuário
// ------------------------------------------------------------
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  locale    String   @default("pt-BR")
  timezone  String   @default("America/Sao_Paulo")
  dashboard Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// Tokens de verificação (Auth.js) — recuperação de senha / e-mail
// ------------------------------------------------------------
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
// Conexão com redes sociais — estrutura preparada.
// Fase 1 NÃO integra. Token só será armazenado encriptado
// (aes-256-gcm) na fase da Meta — nunca em texto puro.
// ------------------------------------------------------------
model SocialConnection {
  id                String           @id @default(cuid())
  userId            String
  platform          String // "instagram" (única rede na Fase 2)
  externalAccountId String?
  username          String?
  accountType       String           @default("BUSINESS")
  status            ConnectionStatus @default(DISCONNECTED)
  tokenEncrypted    String? // SEMPRE encriptado (aes-256-gcm) — nunca texto puro
  tokenExpiresAt    DateTime?
  scopes            String? // escopos concedidos, separados por espaço
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  igProfiles     InstagramProfile[]
  tiktokProfiles TikTokProfile[]

  @@unique([userId, platform])
  @@index([platform])
}

// ------------------------------------------------------------
// State de autorização OAuth (Meta/Instagram) — CSRF protection.
// Gerado no /connect, consumido no /callback. Expira em minutos.
// ------------------------------------------------------------
model OAuthState {
  id           String   @id @default(cuid())
  userId       String
  provider     String   @default("instagram")
  state        String   @unique
  consumed     Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  // PKCE (TikTok) — code_verifier associado ao state, necessário no callback.
  codeVerifier String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([state])
}

// ------------------------------------------------------------
// Dados do Instagram (Fase 3) — histórico temporal para comparação.
// NUNCA inventar métricas: valores ausentes ficam null/indisponível.
// ------------------------------------------------------------

// Perfil da conta conectada — estado atual + referência p/ snapshots.
model InstagramProfile {
  id                 String   @id @default(cuid())
  userId             String
  socialConnectionId String   @unique
  igAccountId        String   @unique // Instagram Business Account ID
  username           String?
  name               String?
  followersCount     Int?
  followsCount       Int?
  mediaCount         Int?
  profilePictureUrl  String?
  biography          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection SocialConnection    @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  snapshots  InstagramSnapshot[]
  medias     InstagramMedia[]

  @@index([userId])
  @@index([igAccountId])
}

// Snapshot temporal — um por sincronização. Guarda o "estado naquele momento".
model InstagramSnapshot {
  id         String   @id @default(cuid())
  profileId  String
  userId     String
  capturedAt DateTime @default(now())

  followersCount Int?
  followsCount   Int?
  mediaCount     Int?

  // Métricas de período (janela da API: 1 dia / 7 dias / etc.) quando disponíveis.
  reach        Int?
  impressions  Int?
  profileViews Int?
  // Engajamento agregado quando a API fornecer (não inventar).
  engagement   Int?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile InstagramProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([profileId, capturedAt])
}

// Mídia (post/reel/story) publicada — metadados + link p/ métricas.
model InstagramMedia {
  id            String    @id @default(cuid())
  profileId     String
  userId        String
  igMediaId     String // Instagram Media ID
  mediaType     String? // IMAGE / VIDEO / CAROUSEL_ALBUM / REEL / STORY
  permalink     String?
  caption       String?
  timestamp     DateTime?
  likeCount     Int?
  commentsCount Int?
  mediaUrl      String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile InstagramProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  metrics InstagramMediaMetric[]

  @@unique([igMediaId])
  @@index([userId, timestamp])
}

// Métricas por mídia — somente campos realmente retornados pela API.
model InstagramMediaMetric {
  id            String   @id @default(cuid())
  mediaId       String
  userId        String
  igMediaId     String
  reached       Int?
  impressions   Int?
  shares        Int?
  saves         Int?
  comments      Int?
  likes         Int?
  videoViews    Int?
  videoViewTime Int? // segundos, quando a API fornecer
  capturedAt    DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media InstagramMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId, capturedAt])
}

// Log de sincronização — auditabilidade e diagnóstico.
model SyncLog {
  id          String   @id @default(cuid())
  userId      String
  platform    String // "instagram" | "tiktok"
  status      String // "success" | "error"
  message     String?
  itemsSynced Int?
  durationMs  Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, createdAt])
}

// ------------------------------------------------------------
// Dados do TikTok (Fase 3.5) — multiplataforma.
// Mesma filosofia do Instagram: NUNCA inventar métricas.
// ------------------------------------------------------------

// Perfil da conta TikTok conectada.
model TikTokProfile {
  id                 String   @id @default(cuid())
  userId             String
  socialConnectionId String   @unique
  tiktokUserId       String   @unique // open_id do TikTok
  username           String?
  displayName        String?
  avatarUrl          String?
  followersCount     Int?
  followingCount     Int?
  videoCount         Int?
  likesCount         Int?
  bio                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  snapshots  TikTokSnapshot[]
  videos     TikTokVideo[]

  @@index([userId])
  @@index([tiktokUserId])
}

// Snapshot temporal — um por sincronização.
model TikTokSnapshot {
  id         String   @id @default(cuid())
  profileId  String
  userId     String
  capturedAt DateTime @default(now())

  followersCount Int?
  followingCount Int?
  videoCount     Int?
  likesCount     Int?
  // Métricas de período quando a API fornecer (nunca inventar).
  viewsCount     Int?
  profileViews   Int?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile TikTokProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([profileId, capturedAt])
}

// Vídeo do TikTok — metadados + link para métricas.
model TikTokVideo {
  id            String    @id @default(cuid())
  profileId     String
  userId        String
  tiktokVideoId String // video_id do TikTok
  title         String?
  coverUrl      String?
  videoUrl      String?
  embedUrl      String?
  likeCount     Int?
  commentCount  Int?
  shareCount    Int?
  playCount     Int?
  timestamp     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile TikTokProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([tiktokVideoId])
  @@index([userId, timestamp])
}

// ------------------------------------------------------------
// FASE 4 — IA E INTELIGÊNCIA
// ------------------------------------------------------------
// Princípios (docs/ESCOPO-OFICIAL.md):
// - NUNCA inventar dados: campos ausentes → null/indisponível.
// - Nada de conhecimento proprietário de crescimento ainda.
// - Conteúdo IA só existe se gerado com API key real configurada.

// Conversa persistida do chat IA Acessor. Uma por usuário/título.
model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String // título curto, gerado a partir da 1ª pergunta ou padrão
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

// Mensagem de uma conversa (user/assistant). Persistida no Neon.
model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

// "O que a IA aprendeu sobre você". NUNCA preenchido com conhecimento
// inventado — apenas com sinais observáveis (perfil + interações reais).
model AIProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  summary            String?
  niche              String?
  subNiche           String?
  objectives         String? // texto curto; lista separada por " | "
  communicationStyle String?
  observedPatterns   String?
  preferredFormats   String?
  ctaPatterns        String?
  hookPatterns       String?
  postingFrequency   String?
  voiceTone          String?
  writingStyle       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Copy gerado (legenda/Reel/Story/carrossel/TikTok/CTA/headline/bio/anúncio).
model GeneratedCopy {
  id         String   @id @default(cuid())
  userId     String
  platform   String // "instagram" | "tiktok"
  format     String // "legenda" | "reel" | "story" | "carrossel" | "tiktok" | "cta" | "headline" | "bio" | "anuncio"
  objective  String?
  tone       String?
  audience   String?
  context    String?
  content    String // texto gerado
  hookType   String? // tipo de gancho aplicado (regra oficial, quando usada)
  structure  String? // estrutura de copy sugerida
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedContents PlannedContent[]

  @@index([userId, createdAt])
}

// Ideia de conteúdo. Status: NOVA | FAVORITA | DESCARTADA | PRODUZIDA.
model ContentIdea {
  id        String   @id @default(cuid())
  userId    String
  category  String // "reels" | "stories" | "carrossel" | "tiktok" | "educativo" | "autoridade" | "venda" | "engajamento"
  title     String
  format    String?
  objective String?
  context   String?
  rationale String? // "Por que esta ideia foi sugerida?" (integração Fase 4.5)
  status    String   @default("NOVA") // NOVA | FAVORITA | DESCARTADA | PRODUZIDA
  platform  String? // "instagram" | "tiktok" | null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedContents PlannedContent[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// Rascunho de publicação (Preview Social) — prepara futura Central de
// Publicações. NUNCA publica: armazena apenas o que o usuário montar.
model SocialDraft {
  id        String   @id @default(cuid())
  userId    String
  platform  String // "instagram" | "tiktok"
  mediaType String   @default("image") // "image" | "video" — da capa (1º item)
  mediaUrl  String? // data URL (upload local apenas na memória do browser)
  caption   String?
  hashtags  String?
  format    String? // "post" | "reel" | "story" | "carrossel" | "video"
  // Fase 6.5: itens do carrossel (até 7) + edições visuais.
  // Cada item: { uid, order, mediaType, mediaUrl, edits }
  // edits (client-side, leve): { ratio, rotate, zoom, offsetX, offsetY, brightness, contrast }
  // NENHUM id de mídia externo é inventado — uids são locais gerados no client.
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedContents PlannedContent[]

  @@index([userId, createdAt])
}

// ------------------------------------------------------------
// FASE 6.5 — PLANOS OFICIAIS E ASSINATURA
// ------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique // "semanal" | "mensal" | "anual"
  name            String // "Semanal" | "Mensal" | "Anual"
  priceCents      Int // SEMPRE centavos inteiros (2700 | 7700 | 49700). NUNCA Float.
  currency        String   @default("BRL")
  type            String   @default("ONE_TIME") // "ONE_TIME" | "RECURRING"
  billingInterval String? // null (avulso) | "MONTH" | "YEAR"
  durationDays    Int? // 7 (semanal) — duração do acesso
  description     String?
  features        String[] // recursos liberados
  badge           String? // "MAIS_ESCOLHIDO" | "MELHOR_CUSTO_BENEFICIO"
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  status                 String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELED | PAST_DUE
  billingType            String    @default("ONE_TIME") // ONE_TIME | RECURRING
  billingInterval        String? // null | MONTH | YEAR
  startAt                DateTime? // data de confirmação do pagamento
  expiresAt              DateTime? // startAt + duração (ex.: +7 dias)
  autoRenew              Boolean   @default(false) // Semanal: false
  nextBillingAt          DateTime? // próxima cobrança (recorrentes)
  canceledAt             DateTime? // cancelamento da renovação futura
  provider               String? // "asaas" — preenchido SOMENTE quando o gateway estiver ativo
  externalCustomerId     String? // NUNCA inventado — preenchido pelo gateway real
  externalSubscriptionId String? // NUNCA inventado — preenchido pelo gateway real
  externalPaymentId      String? // NUNCA inventado — pagamento que originou a assinatura (gateway real)
  // Preço travado na criação (NUNCA lido do client) — preserva valor cobrado
  // mesmo que o catálogo mude depois.
  amountCents            Int?
  currency               String    @default("BRL")
  paidAt                 DateTime? // confirmação REAL de pagamento (webhook)
  idempotencyKey         String? // chave de idempotência da criação (evita duplicar checkout/cobrança)
  // Origem do acesso: "ASAAS" (pagamento confirmado) | "ADMIN_MANUAL" (liberação
  // manual pelo admin). Permite distinguir acesso pago de acesso concedido e
  // prepara a fase futura de "primeiro acesso".
  accessSource           String?
  // ID do admin que executou uma liberação manual (somente ADMIN_MANUAL).
  grantedByAdminId       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  payments      Payment[]
  billingEvents BillingEvent[]

  @@unique([idempotencyKey])
  @@index([userId, status])
  @@index([planId])
  @@index([userId, expiresAt])
  @@index([externalSubscriptionId])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  planId            String?
  subscriptionId    String?
  amountCents       Int // centavos inteiros — NUNCA Float
  currency          String    @default("BRL")
  status            String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | EXPIRED
  provider          String? // "asaas" — preenchido SOMENTE quando gateway ativo
  externalPaymentId String? // NUNCA inventado — preenchido pelo gateway real
  paidAt            DateTime?
  // Fase 6.5 (Asaas) — rastreio do evento que criou/atualizou este registro:
  // idempotência + rastreabilidade. NUNCA contém secrets.
  eventType         String? // ex.: PAYMENT_CONFIRMED (nome oficial do gateway)
  eventId           String? // id externo do evento (idempotência)
  createdAt         DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([eventId])
  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([externalPaymentId])
}

// Rastreamento de eventos de billing (webhook) — idempotência e auditoria.
// Cada evento oficial processado do Asaas é registrado UMA única vez
// (eventId @@unique). NUNCA contém secrets. userId só é preenchido quando o
// sistema localizou o dono pela referência externa — nunca confia no payload.
model BillingEvent {
  id             String        @id @default(cuid())
  eventId        String        @unique // id externo do evento (ex.: asaas event id) — idempotência
  provider       String        @default("asaas")
  type           String // nome oficial do evento (ex.: PAYMENT_CONFIRMED)
  userId         String? // dono identificado localmente (nullable — não confiável do payload)
  subscriptionId String?
  payload        Json? // payload sanitizado (sem tokens/secrets)
  processed      Boolean       @default(false)
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  User           User?         @relation(fields: [userId], references: [id])
  Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([processed])
}

// ------------------------------------------------------------
// FASE "PRIMEIRO ACESSO" — ATIVAÇÃO DO ACESSO PÓS-COMPRA
// ------------------------------------------------------------
// Princípios:
// - O direito de acesso é vinculado ao E-MAIL da compra (origem ASAAS ou
//   ADMIN_MANUAL). `AccessGrant` existe independente do User para permitir
//   liberar o acesso ANTES de o cliente criar conta/senha (cenários B/D).
// - "PRIMEIRO ACESSO" = o cliente prova a posse do e-mail, cria a própria
//   senha e entra. NUNCA é gerada senha temporária/fixa.
// - `AccessGrant.userId` é preenchido quando uma conta é associada.
// - Estados: PENDING_FIRST_ACCESS | ACTIVE | EXPIRED | CANCELED.
// - Reusa `Subscription.accessSource` para ASAAS/ADMIN_MANUAL quando o User
//   já existe; AccessGrant complementa para e-mails sem conta.

model AccessGrant {
  id                     String    @id @default(cuid())
  // E-mail da compra/concessão (normalizado). É a identidade inicial do acesso.
  email                  String
  userId                 String? // associado quando o cliente cria/vincula a conta
  planId                 String? // plano de referência (opcional; não é compra)
  planName               String? // snapshot do nome do plano (sem join obrigatório)
  origin                 String // "ASAAS" | "ADMIN_MANUAL"
  status                 String    @default("PENDING_FIRST_ACCESS")
  // PENDING_FIRST_ACCESS | ACTIVE | EXPIRED | CANCELED
  startAt                DateTime
  expiresAt              DateTime?
  // Rastreio da liberação manual (somente ADMIN_MANUAL).
  grantedByAdminId       String?
  // Rastreio da compra (somente ASAAS) — referência externa real, nunca inventada.
  externalPaymentId      String?
  externalSubscriptionId String?
  // Primeiro acesso concluído (senha criada e acesso confirmado).
  firstAccessCompleted   Boolean   @default(false)
  firstAccessCompletedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, origin, externalPaymentId])
  @@index([email, status])
  @@index([userId, status])
}

// Token de USO ÚNICO para prova de posse do e-mail no primeiro acesso.
// - Aleatório (crypto.randomBytes), expira em minutos/horas, inválido após uso.
// - NUNCA aparece em logs; apenas o hash é comparável.
// - Não usa JWT eterno — é um token opaco de banco, sem assinatura própria.
model FirstAccessToken {
  id        String    @id @default(cuid())
  email     String // normalizado
  tokenHash String    @unique // hash SHA-256 do token (nunca o token cru)
  expiresAt DateTime
  usedAt    DateTime?
  consumed  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([email])
}

// ARQUITETURA PREPARADA para Passkey/WebAuthn (OPCIONAL).
// ⚠️ A implementação WebAuthn é PENDÊNCIA TÉCNICA CONTROLADA nesta fase:
// NENHUM dado biométrico é armazenado — na Web o dispositivo guarda a
// credencial e o servidor guarda apenas o credentialId + publicKey (não
// sensível). Até que o fluxo completo (registration + authentication + UI)
// seja validado, este model permanece PREPARADO, não ativo.
model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  // Credencial WebAuthn — credencialId + publicKey são gerados pelo
  // dispositivo/browser e NÃO são dados biométricos.
  credentialId String    @unique
  publicKey    String
  transports   String? // "internal" (Face ID/Touch ID/Windows Hello) | "usb" | ...
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Recomendação de mentoria — derivada de métricas reais + regras oficiais
// da base de conhecimento. Nunca conhecimento externo.
model MentorshipRecommendation {
  id          String   @id @default(cuid())
  userId      String
  category    String // "crescimento" | "engajamento" | "frequencia" | "consistencia" | "conteudo" | "alcance" | "perfil"
  priority    String   @default("MEDIA") // ALTA | MEDIA | BAIXA
  problem     String
  explanation String?
  action      String?
  evidence    String? // qual dado real sustenta a recomendação
  ruleSlug    String? // regra oficial aplicada (conhecimento)
  test        String? // como validar a recomendação
  result      String? // resultado posterior observado
  status      String   @default("NOVA") // NOVA | APLICADA | IGNORADA | CONCLUIDA
  source      String? // identificador do dado que gerou (ex.: "instagram-snapshots")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// Score inteligente (0-100) — determinístico, explicável, versionado.
// Um por avaliação. Snapshot preserva o histórico.
model ProfileScore {
  id          String   @id @default(cuid())
  userId      String
  platform    String // "instagram" | "tiktok"
  overall     Int // 0-100
  growth      Int?
  engagement  Int?
  reach       Int?
  consistency Int?
  frequency   Int?
  content     Int?
  // JSON com fatores: { positive: [...], attention: [...], unavailable: [...] }
  factors     Json?
  version     String   @default("growth-score-v1") // fórmula versionável
  coverage    Int? // cobertura dos dados (%): quanto do score foi calculável
  weighting   Json? // pesos aplicados { engagement, growth, reach, consistency }
  createdAt   DateTime @default(now())

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ProfileScoreSnapshot ProfileScoreSnapshot[]

  @@index([userId, platform, createdAt])
}

// Snapshot temporal do score — histórico de evolução.
model ProfileScoreSnapshot {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  scoreId   String
  overall   Int
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  score ProfileScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([userId, platform, createdAt])
}

// ------------------------------------------------------------
// FASE 4.5 — CÉREBRO ESTRATÉGICO (Base de Conhecimento + Experimentos)
// ------------------------------------------------------------
// Princípios (Fase 4.5, conteúdo oficial da DONA):
// - Conhecimento oficial é GLOBAL (compartilhado entre usuários).
// - Aprendizado individual (AIProfile, ProfileInsight, experimentos) é
//   PRIVADO por userId — nunca misturar entre usuários.
// - Nunca inventar métricas; categorias: DADO REAL, CONHECIMENTO,
//   INFERÊNCIA, HIPÓTESE, RECOMENDAÇÃO.

// Versão da base de conhecimento. Registra o histórico de atualizações.
model KnowledgeVersion {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  label     String? // ex.: "v1 — conteúdo oficial da DONA"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  rules KnowledgeRule[]

  @@unique([version])
  @@index([active])
}

// Módulo de conhecimento (01–30), global.
model KnowledgeModule {
  id          String   @id @default(cuid())
  number      Int // 1..30
  slug        String   @unique
  title       String
  description String?
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules KnowledgeRule[]

  @@unique([number, version])
  @@index([active])
}

// Regra de conhecimento oficial (global), versionável por slug+version.
model KnowledgeRule {
  id        String   @id @default(cuid())
  slug      String
  moduleId  String?
  module    Int
  title     String
  category  String
  content   String
  type      String // PRINCIPLE | DIAGNOSTIC_RULE | STRATEGY_RULE | CONTENT_RULE | METRIC_RULE | EXPERIMENT_RULE | AI_GUARDRAIL
  priority  String   @default("MEDIA") // ALTA | MEDIA | BAIXA
  tags      String[] // string array nativo (Neon/Postgres)
  version   Int      @default(1)
  versionId String? // FK para KnowledgeVersion.id
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleRef  KnowledgeModule?  @relation(fields: [moduleId], references: [id])
  versionRef KnowledgeVersion? @relation(fields: [versionId], references: [id])

  @@unique([slug, version])
  @@index([category])
  @@index([module])
  @@index([active])
}

// Experimento de crescimento (por usuário). NUNCA estatística fictícia:
// sem amostra suficiente → INCONCLUSIVE.
model GrowthExperiment {
  id         String    @id @default(cuid())
  userId     String
  platform   String // "instagram" | "tiktok"
  hypothesis String
  variable   String // o que está sendo variado (ex.: gancho, formato, tema)
  baseline   String? // baseline individual de referência
  status     String    @default("DRAFT") // DRAFT | RUNNING | ENOUGH_DATA | CONFIRMED | REJECTED | INCONCLUSIVE | ARCHIVED
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants        ExperimentVariant[]
  observations    ExperimentObservation[]
  plannedContents PlannedContentExperiment[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// Variação de um experimento — um conteúdo testado com um conjunto de
// elementos (gancho, formato, tema, estrutura).
model ExperimentVariant {
  id           String   @id @default(cuid())
  experimentId String
  contentId    String? // vínculo futuro com conteúdo publicado
  variation    String? // descrição da variação
  hookType     String?
  format       String?
  theme        String?
  structure    String?
  createdAt    DateTime @default(now())

  experiment GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

// Observação coletada de um experimento (antes/depois).
model ExperimentObservation {
  id           String   @id @default(cuid())
  experimentId String
  metric       String // ex.: "alcance", "engajamento", "seguidores"
  before       Float?
  after        Float?
  delta        Float?
  conclusion   String?
  confidence   String? // "BAIXA" | "MEDIA" | "ALTA" — nunca falsa precisão
  createdAt    DateTime @default(now())

  experiment GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

// Aprendizado individual do perfil (padrões observados). NUNCA promover
// inferência a confirmado automaticamente.
model ProfileInsight {
  id           String   @id @default(cuid())
  userId       String
  platform     String // "instagram" | "tiktok"
  type         String // OBSERVED | INFERRED | CONFIRMED_BY_EXPERIMENT
  summary      String
  detail       String?
  ruleSlug     String? // regra oficial aplicada (conhecimento), quando houver
  experimentId String? // vínculo opcional com experimento que confirmou
  confidence   String? // BAIXA | MEDIA | ALTA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}

// ------------------------------------------------------------
// FASE 5 — RANK, XP, METAS, CONQUISTAS E PROGRESSÃO
// ------------------------------------------------------------
// Princípios (Fase 5, integrada ao Knowledge Engine — Módulo 28):
// - XP ~5–100 conforme dificuldade; valores versionáveis/configuráveis.
// - Idempotência: a MESMA ação real NUNCA concede XP duas vezes
//   (chave única source + refId em XpLog).
// - Conquistas ligadas a ações reais; progresso individual por usuário.
// - Ao atingir ~70% de um conjunto, novos desafios mais difíceis entram.
// - Nada de gamificação vazia: XP/metas/conquistas refletem comportamentos
//   que contribuem para crescimento (consistência, executar recomendações,
//   testar, acompanhar resultados, completar experimentos, planejar, etc.).

// Estado de progressão do usuário (1:1). XP total + nível atual + histórico.
model UserLevel {
  id            String    @id @default(cuid())
  userId        String    @unique
  xp            Int       @default(0) // XP total acumulado
  level         Int       @default(1)
  totalXpEarned Int       @default(0) // soma de todos os XP concedidos (auditoria agregada)
  lastLevelUpAt DateTime? // quando subiu de nível pela última vez
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([xp])
}

// Auditoria de concessão de XP. Idempotente: @@unique([source, refId]).
// "source" identifica a ação (ex.: "salvar-copy", "completar-experimento").
// "refId" identifica o recurso exato (ex.: id do copy / do experimento).
// A MESMA combinação só pode ser registrada UMA vez.
model XpLog {
  id        String   @id @default(cuid())
  userId    String
  source    String // tipo de ação que concedeu XP
  refId     String // id do recurso/ação que gerou o XP
  amount    Int // XP concedido (5–100)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, refId])
  @@index([userId, createdAt])
  @@index([source, refId])
}

// Meta estratégica do usuário. Categorias: crescimento/engajamento/consistência.
// "currentValue"/"targetValue" são preenchidos por dados reais ou ação do usuário.
model UserGoal {
  id           String    @id @default(cuid())
  userId       String
  category     String // "crescimento" | "engajamento" | "consistencia"
  title        String
  description  String?
  targetValue  Float? // valor a atingir (ex.: +50 seguidores, 4 posts/semana)
  currentValue Float? // progresso atual (atualizado com dados reais)
  unit         String? // "seguidores" | "posts" | "%" | null
  platform     String? // "instagram" | "tiktok" | null
  status       String    @default("ATIVA") // ATIVA | CONCLUIDA | CANCELADA
  deadline     DateTime? // prazo opcional
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedContents PlannedContent[]

  @@index([userId, status])
  @@index([userId, category])
}

// Catálogo GLOBAL de conquistas (badges). Definidas em código (seed oficial),
// ligadas a comportamentos reais. Nenhuma conquista inventada.
model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String // "consistencia" | "engajamento" | "crescimento" | "uso" | "estrategia"
  xpReward    Int // XP concedido ao desbloquear (5–100)
  threshold   Int // progresso necessário (ex.: 1, 3, 7 posts; 1 experimento)
  unit        String? // unidade do threshold ("posts" | "experimentos" | "dias" | "vezes")
  tier        String   @default("BRONZE") // BRONZE | PRATA | OURO | DESAFIO
  hidden      Boolean  @default(false) // desafios difíceis (após ~70%)
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserAchievement[]

  @@index([category])
  @@index([active])
}

// Conquista por usuário — progresso individual, bloqueio/desbloqueio, histórico.
model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0) // progresso atual (0..threshold)
  unlocked      Boolean   @default(false)
  unlockedAt    DateTime? // quando desbloqueou (histórico)
  xpGranted     Boolean   @default(false) // se o XP da conquista já foi concedido
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlocked])
  @@index([achievementId])
}

// ------------------------------------------------------------
// FASE 6 — PLANEJAMENTO, CALENDÁRIO E PIPELINE DE CONTEÚDO
// ------------------------------------------------------------
// Princípios (Fase 6, integrada ao Knowledge Engine — Módulo 25):
// - Calendário transforma recomendação em execução: O QUE → QUANDO → COMO → O QUE MEDIR.
// - Pipeline de conteúdo com estados claros. NUNCA marcar PUBLICADO sem
//   confirmação real futura da integração (diferencia "agendado internamente"
//   de "publicado pela plataforma").
// - Relações com Ideias, Copy (versionada), Preview, Experimentos e Metas.
// - Nada de integração externa ainda; preparação arquitetural para adapters
//   em src/lib/publishing/.

// Conteúdo planejado no calendário (pipeline de conteúdo).
// Estados (consistentes com ESCOPO-OFICIAL): RASCUNHO | IDEIA | EM_PRODUCAO |
// PRONTO | AGENDADO | PUBLICADO | CANCELADO | FALHOU.
// "PUBLICADO" só deve ser marcado com confirmação real futura do adapter.
model PlannedContent {
  id          String    @id @default(cuid())
  userId      String
  platform    String    @default("instagram") // "instagram" | "tiktok"
  format      String    @default("reel") // "reel" | "story" | "carrossel" | "post" | "video"
  title       String // título interno do conteúdo
  theme       String? // tema do conteúdo
  objective   String? // objetivo (alcance, engajamento, autoridade, venda...)
  status      String    @default("RASCUNHO") // pipeline de conteúdo
  scheduledAt DateTime? // data/horário planejado (agendamento INTERNO)
  publishedAt DateTime? // preenchido apenas com confirmação real futura
  externalId  String? // id externo da plataforma (NUNCA inventado)
  notes       String? // observações
  hypothesis  String? // hipótese estratégica (quando ligado a experimento)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relações com o conteúdo já existente (Fase 4)
  ideaId  String?
  copyId  String?
  draftId String? // Preview Social (SocialDraft)
  goalId  String? // meta estratégica da Fase 5 (UserGoal)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea  ContentIdea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  copy  GeneratedCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)
  draft SocialDraft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  goal  UserGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)

  experiments  PlannedContentExperiment[]
  copyVersions ContentCopyVersion[]
  publishQueue PublishQueue[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([userId, platform])
  @@index([ideaId])
  @@index([copyId])
  @@index([goalId])
}

// Associação N:N entre conteúdo planejado e experimentos (Fase 4.5).
// Um conteúdo pode testar várias hipóteses; um experimento pode ter vários conteúdos.
model PlannedContentExperiment {
  id           String   @id @default(cuid())
  contentId    String
  experimentId String
  createdAt    DateTime @default(now())

  content    PlannedContent   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  experiment GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([contentId, experimentId])
  @@index([experimentId])
}

// Versionamento simples da copy vinculada a um conteúdo.
// Nunca sobrescreve silenciosamente uma versão anterior importante.
model ContentCopyVersion {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  version   Int // 1, 2, 3...
  content   String // texto da copy nesta versão
  note      String? // observação da versão (ex.: "revisada pós-feedback")
  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedContent PlannedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([userId, contentId])
}

// ------------------------------------------------------------
// FASE 7 — PUBLICAÇÃO REAL, FILA E CENTRAL DE PUBLICAÇÃO
// ------------------------------------------------------------
// Princípios (Fase 7, ESCOPO-OFICIAL + Knowledge Engine Módulo 26):
// - PUBLICADO SÓ com confirmação real do provider. NUNCA por tempo.
// - PROCESSANDO = tentativa real em andamento.
// - FALHOU guarda motivo; retry controlado (máx. 3), sem loop infinito.
// - Filas em banco (Vercel-compatível, sem Redis/BullMQ).
// - Logs NUNCA guardam tokens/secrets/payloads sensíveis.
// - Automações são FUNDAÇÃO apenas (sem DM real, sem disparo real).

// Fila de publicação — um registro por conteúdo/platform a publicar.
// Vercel-compatível (banco): o processamento é disparado por API/cron
// (processQueue) e lê os itens AGENDADO/PROCESSANDO.
model PublishQueue {
  id             String    @id @default(cuid())
  userId         String
  contentId      String // PlannedContent.id
  platform       String // "instagram" | "tiktok"
  format         String // "post" | "carrossel" | "reel" | "story" | "video"
  status         String    @default("AGENDADO")
  // AGENDADO | PROCESSANDO | PUBLICADO | FALHOU | CANCELADO
  scheduledAt    DateTime? // quando deve ser publicado
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime? // backoff
  errorCode      String? // classificação segura (RETRYABLE | PERMANENT | AUTH | ...)
  errorMessage   String? // mensagem amigável/sanitizada — nunca segredos
  externalId     String? // id externo REAL da plataforma (nunca inventado)
  provider       String? // qual adapter tentou (ex.: "instagram")
  idempotencyKey String? // chave de idempotência por tentativa
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content PlannedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, platform])
  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
}

// Log de operações de publicação — auditoria segura.
// NUNCA armazena access token, refresh token, client secret ou payload sensível.
model PublishLog {
  id           String   @id @default(cuid())
  userId       String
  queueId      String?
  contentId    String?
  platform     String // "instagram" | "tiktok"
  operation    String // "publish" | "retry" | "cancel" | "schedule" | "status"
  status       String // "success" | "error" | "skipped"
  attempts     Int      @default(0)
  errorCode    String? // classificação segura
  errorMessage String? // mensagem amigável/sanitizada
  externalId   String? // id externo REAL (nunca inventado)
  provider     String? // adapter usado
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([queueId])
  @@index([platform, status])
}

// Fundação de automações (Comentário→DM futuro). NENHUMA chamada real.
// Regras definidas pela DONA; execução só quando a integração real existir.
model AutomationRule {
  id        String   @id @default(cuid())
  userId    String
  name      String // nome interno (ex.: "Responder menção de preço")
  trigger   String // ex.: "comment.keyword" — somente estrutura preparada
  platform  String   @default("instagram") // instagram | tiktok
  keywords  String[] // palavras-chave (ex.: ["preço", "quanto custa"])
  action    String   @default("dm") // ação futura (dm) — não executada
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

// Evento de automação recebido (webhook futuro) — preparado estruturalmente.
// Nunca contém tokens. eventId garante idempotência.
model AutomationEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String // id externo do evento (idempotência)
  platform  String // instagram | tiktok
  type      String // ex.: "comment" | "dm" — conforme evento real futuro
  payload   Json? // payload sanitizado (sem tokens/secrets)
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId])
  @@index([userId, createdAt])
}

// Execução de automação — registro de quando uma regra foi avaliada.
// Nesta fase apenas registra avaliação; nunca executa ação externa real.
model AutomationExecution {
  id        String   @id @default(cuid())
  userId    String
  ruleId    String?
  eventId   String?
  status    String   @default("EVALUATED") // EVALUATED | READY | BLOCKED | SKIPPED
  detail    String? // motivo (ex.: integração não configurada)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------------
// FASE 8 — AUTOMAÇÕES INTELIGENTES + MOTOR OPERACIONAL DE CRESCIMENTO
// ------------------------------------------------------------
// Princípios (Fase 8, ESCOPO-OFICIAL + Knowledge Engine Módulo 27):
// - GrowthAction é a ÚNICA persistência nova da Fase 8 (plano de ação real).
// - NÃO duplica UserGoal nem PlannedContent: uma ação é uma recomendação
//   priorizada executável; metas e conteúdos continuam sendo os de Fase 5/6.
// - DADO REAL obrigatório: baseline/resultado sempre opcionais; nunca inventar.
// - Idempotência: missão do dia / recomendações deduplicam por signal+slug.
// - XP é concedido somente quando a ação é concluída de verdade (Parte 17).

// Ação de crescimento recomendada e rastreada (plano de ação operacional).
model GrowthAction {
  id                   String    @id @default(cuid())
  userId               String
  platform             String // "instagram" | "tiktok"
  title                String // título curto e acionável (ex.: "Publicar 3 Reels por semana")
  description          String? // contexto + O QUE/POR QUÊ
  reason               String? // por que foi recomendada (sinal + evidência)
  priority             String    @default("MEDIA") // PRIORIDADE 1 | 2 | 3
  status               String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DISMISSED | EXPIRED
  dueAt                DateTime? // quando deve ser feita (plano 7/30 dias)
  completedAt          DateTime? // quando concluída de verdade
  dismissedAt          DateTime?
  sourceSignal         String? // signal type (ex.: LOW_POSTING_FREQUENCY)
  sourceRecommendation String? // slug da recomendação (ex.: low-posting-frequency-1)
  metricToWatch        String? // métrica que a ação deve melhorar
  baselineValue        Float? // valor real medido antes (nunca inventado)
  resultValue          Float? // valor real medido depois (preenchido na conclusão)
  resultNote           String? // nota opcional sobre o resultado
  xpGranted            Boolean   @default(false) // XP real pós-conclusão
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueAt])
  @@index([sourceSignal, userId])
}

// ------------------------------------------------------------
// Configurações administrativas do sistema (Fase 10)
// ------------------------------------------------------------
// Guarda preferências GLOBAIS gerenciadas apenas pela área admin.
// Chaves oficiais (namespace "ai.*"): ai.provider, ai.openai.key,
// ai.openai.model, ai.gemini.key, ai.gemini.model.
//
// ⚠️ Valores sensíveis (chaves de API) são SEMPRE encriptados
// (AES-256-GCM via src/lib/crypto.ts) ANTES de gravar. NUNCA em texto puro.
// Chaves NUNCA são devolvidas para o frontend — apenas o sufixo mascarado.
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // ex.: "ai.provider" | "ai.openai.key"
  value     String // valor encriptado (quando sensível) ou texto plano (preferências)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}
