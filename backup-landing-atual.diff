+
+/* ============================================================
+   RODADA DE ESTRATÉGIA — HERO COM DEMONSTRAÇÃO + OS 4 MOVIMENTOS
+   ------------------------------------------------------------
+   Origem: leitura da página de referência enviada pelo usuário
+   (`print de referencia/`) e do link anotado no mesmo diretório.
+
+   O que a referência faz e passou a valer aqui:
+   1. A promessa aparece na PRIMEIRA linha, com o produto NOMEADO.
+      Antes, o Hero explicava a categoria ("plataforma de análise e
+      crescimento") e deixava o nome do produto só no logotipo.
+   2. O produto é DEMONSTRADO logo abaixo do CTA — aqui, numa janela
+      com a interface real do app, no lugar de ilustração genérica.
+   3. Os recursos são agrupados por VERBO (criar, publicar, conversar,
+      crescer) em vez de listados em 20 blocos equivalentes: o visitante
+      entende o produto por etapas, não por inventário.
+
+   Nada aqui é cópia: marca, paleta, tipografia, textos e composição
+   continuam do Inst Acessor. Só o ESQUELETO de conversão foi adaptado.
+
+   Nenhuma cor nova: tudo sai dos tokens já declarados no topo deste
+   arquivo (`--lnd-*`).
+
+   ATENÇÃO a dois nomes: as classes desta seção usam o prefixo
+   `lnd-vmove` / `lnd-vmoves` de propósito. `.lnd-move-*` já pertence à
+   seção de Estratégia (bloco de "Plano de ação", ~linha 4125) e
+   reutilizar o nome misturaria duas composições diferentes.
+   ============================================================ */
+
+/* ---------- HERO: pílula dos quatro verbos ---------- */
+.lnd-hero-verbs {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: center;
+  margin-bottom: 26px;
+  padding: 7px 8px 7px 16px;
+  border-radius: var(--lnd-r-pill);
+  background: var(--lnd-card);
+  border: 1px solid var(--lnd-border);
+  box-shadow: var(--lnd-shadow-xs);
+}
+.lnd-hero-verbs .lnd-verbs-k {
+  font-family: var(--lnd-font-data);
+  font-size: 10.5px;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--lnd-ink-3);
+}
+.lnd-hero-verbs .lnd-verbs-list {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  flex-wrap: wrap;
+}
+.lnd-hero-verbs .lnd-verbs-list span {
+  font-size: 12.5px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--lnd-purple);
+  background: var(--lnd-grad-soft);
+  border-radius: var(--lnd-r-pill);
+  padding: 5px 12px;
+  white-space: nowrap;
+}
+
+/* ---------- HERO: janela de demonstração ----------
+   Ocupa a largura de leitura do Hero, logo abaixo dos CTAs. Cada painel
+   dela corresponde a uma tela que existe no app; todo número leva o selo
+   "Exemplo" — nada aqui é resultado real de cliente. */
+.lnd-demo-wrap {
+  position: relative;
+  z-index: 1;
+  margin-top: clamp(44px, 6vw, 72px);
+  width: 100%;
+  max-width: 1040px;
+  margin-inline: auto;
+}
+.lnd-demo {
+  border-radius: var(--lnd-r-lg);
+  background: var(--lnd-card);
+  border: 1px solid var(--lnd-border);
+  box-shadow: var(--lnd-shadow-lg);
+  overflow: hidden;
+}
+.lnd-demo-bar {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 16px;
+  background: var(--lnd-surface);
+  border-bottom: 1px solid var(--lnd-border-soft);
+}
+.lnd-demo-dots {
+  display: inline-flex;
+  gap: 6px;
+  flex: none;
+}
+.lnd-demo-dots i {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: var(--lnd-border);
+}
+.lnd-demo-url {
+  flex: 1;
+  min-width: 0;
+  text-align: center;
+  font-family: var(--lnd-font-data);
+  font-size: 12px;
+  color: var(--lnd-ink-3);
+  background: var(--lnd-card);
+  border: 1px solid var(--lnd-border-soft);
+  border-radius: var(--lnd-r-pill);
+  padding: 5px 14px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+/* Selo próprio da janela. NÃO reaproveita `.lnd-demo-badge`, que já
+   existe para o rótulo "Demonstração" do Gerador de Copy (linha ~184) e
+   carrega o ponto âmbar + borda tracejada daquele contexto. */
+.lnd-demo-selo {
+  flex: none;
+  font-family: var(--lnd-font-data);
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--lnd-ink-3);
+  border: 1px solid var(--lnd-border);
+  border-radius: var(--lnd-r-pill);
+  padding: 4px 10px;
+}
+.lnd-demo-body {
+  display: grid;
+  grid-template-columns: 190px minmax(0, 1fr) 250px;
+  gap: 1px;
+  background: var(--lnd-border-soft);
+}
+.lnd-demo-col {
+  background: var(--lnd-card);
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  min-width: 0;
+}
+.lnd-demo-col-side {
+  background: var(--lnd-bg);
+}
+.lnd-demo-col-title {
+  font-family: var(--lnd-font-data);
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--lnd-ink-3);
+}
+.lnd-demo-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.lnd-demo-nav span {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 12.5px;
+  font-weight: 600;
+  color: var(--lnd-ink-2);
+  border-radius: var(--lnd-r-xs);
+  padding: 7px 9px;
+}
+.lnd-demo-nav span i {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--lnd-border);
+  flex: none;
+}
+.lnd-demo-nav span.lnd-on {
+  color: var(--lnd-purple);
+  background: var(--lnd-grad-soft);
+}
+.lnd-demo-nav span.lnd-on i {
+  background: var(--lnd-purple);
+}
+.lnd-demo-topline {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+.lnd-demo-topline b {
+  font-family: var(--lnd-font-display);
+  font-size: 15px;
+  font-weight: 700;
+  color: var(--lnd-ink);
+}
+.lnd-demo-chip {
+  font-family: var(--lnd-font-data);
+  font-size: 10.5px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: var(--lnd-success);
+  background: var(--lnd-success-soft);
+  border-radius: var(--lnd-r-pill);
+  padding: 4px 10px;
+}
+.lnd-demo-week {
+  display: grid;
+  grid-template-columns: repeat(7, minmax(0, 1fr));
+  gap: 6px;
+}
+.lnd-demo-day {
+  border: 1px solid var(--lnd-border-soft);
+  border-radius: var(--lnd-r-sm);
+  padding: 9px 6px;
+  text-align: center;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  background: var(--lnd-card);
+}
+.lnd-demo-day span {
+  font-family: var(--lnd-font-data);
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--lnd-ink-3);
+}
+.lnd-demo-day b {
+  font-size: 11.5px;
+  font-weight: 700;
+  color: var(--lnd-ink);
+}
+.lnd-demo-day em {
+  font-style: normal;
+  font-size: 9.5px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--lnd-purple);
+}
+.lnd-demo-day.lnd-best {
+  border-color: rgba(139, 92, 246, 0.35);
+  background: var(--lnd-grad-soft);
+}
+.lnd-demo-queue {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.lnd-demo-queue div {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  border: 1px solid var(--lnd-border-soft);
+  border-radius: var(--lnd-r-sm);
+  padding: 8px 10px;
+}
+.lnd-demo-queue div i {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  flex: none;
+  background: var(--lnd-info);
+}
+.lnd-demo-queue div.lnd-ok i {
+  background: var(--lnd-success);
+}
+.lnd-demo-queue div.lnd-wait i {
+  background: var(--lnd-warn);
+}
+.lnd-demo-queue div b {
+  font-size: 12.5px;
+  font-weight: 600;
+  color: var(--lnd-ink);
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.lnd-demo-queue div span {
+  font-family: var(--lnd-font-data);
+  font-size: 10.5px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--lnd-ink-3);
+  flex: none;
+}
+.lnd-demo-kpis {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.lnd-demo-kpi {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 10px;
+  border: 1px solid var(--lnd-border-soft);
+  border-radius: var(--lnd-r-sm);
+  padding: 9px 11px;
+  background: var(--lnd-card);
+}
+.lnd-demo-kpi span {
+  font-size: 11.5px;
+  color: var(--lnd-ink-2);
+}
+.lnd-demo-kpi b {
+  font-family: var(--lnd-font-data);
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--lnd-ink);
+}
+.lnd-demo-note {
+  margin-top: 14px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  font-size: 12.5px;
+  color: var(--lnd-ink-3);
+  text-align: center;
+}
+.lnd-demo-note svg {
+  flex: none;
+}
+
+@media (max-width: 900px) {
+  .lnd-demo-body {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  /* No celular a janela mostra o essencial: a coluna central (calendário
+     e fila) e os números. O menu lateral da janela é decoração de
+     desktop — escondê-lo evita uma lista de 5 itens sem função no toque. */
+  .lnd-demo-col-side:first-child {
+    display: none;
+  }
+}
+@media (max-width: 520px) {
+  .lnd-demo-week {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+}
+
+/* ---------- SEÇÃO: CRIE · PUBLIQUE · CONVERSE · CRESÇA ---------- */
+/* Dois cards por linha, não quatro.
+   ------------------------------------------------------------
+   Medido na página de referência (`print de referencia/`): os cards
+   grandes ficam entre 550 e 580px de largura num container de 1120px —
+   duas ou três colunas, nunca quatro. Em quatro colunas cada card cai
+   para ~266px e o texto interno fica espremido, que é exatamente o que
+   esta rodada pede para evitar ("poucos cards grandes e bem
+   apresentados"). Em duas colunas o card vai a ~570px e o bloco interno
+   respira como na referência. */
+.lnd-vmoves {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: clamp(20px, 2vw, 28px);
+}
+.lnd-vmove {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  /* Padding e raio proporcionais ao card maior. A referência usa raio de
+     ~24px num card de ~577px (≈4,2% da largura); em ~570px isso dá ~24px,
+     que é o token `--lnd-r-lg` (22px). O `--lnd-r-md` (16px) era o raio de
+     quando o card tinha 266px de largura. */
+  padding: clamp(26px, 2.8vw, 36px) clamp(22px, 2.6vw, 32px) clamp(24px, 2.6vw, 32px);
+  border-radius: var(--lnd-r-lg);
+  border: 1px solid var(--lnd-border);
+  background: var(--lnd-card);
+  box-shadow: var(--lnd-shadow-xs);
+  transition:
+    transform 0.35s var(--lnd-ease-out),
+    box-shadow 0.35s ease,
+    border-color 0.35s ease;
+}
+.lnd-vmove:hover {
+  transform: translateY(-4px);
+  box-shadow: var(--lnd-shadow-md);
+  border-color: rgba(139, 92, 246, 0.28);
+}
+.lnd-vmove-top {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.lnd-vmove-n {
+  font-family: var(--lnd-font-data);
+  font-size: 11.5px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: var(--lnd-ink-3);
+}
+.lnd-vmove-ic {
+  width: 40px;
+  height: 40px;
+  border-radius: var(--lnd-r-sm);
+  display: grid;
+  place-items: center;
+  background: var(--lnd-grad-soft);
+  color: var(--lnd-purple);
+  flex: none;
+}
+.lnd-vmove-verb {
+  font-family: var(--lnd-font-display);
+  font-size: 20px;
+  font-weight: 800;
+  letter-spacing: 0.01em;
+  text-transform: uppercase;
+  background: var(--lnd-grad);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.lnd-vmove p {
+  font-size: 14.5px;
+  line-height: 1.6;
+  color: var(--lnd-ink-2);
+  /* Sem teto de linha de propósito. Medi a versão com `max-width: 48ch`
+     (375px) dentro do card de 586px: sobravam 149px de branco à direita e
+     o card parecia pela metade. As frases têm 110–130 caracteres, o que
+     em 14,5px ao longo de ~522px dá exatamente 2 linhas cheias em todos
+     os quatro cards — mais próximo do card da referência, cujo miolo
+     também é preenchido de ponta a ponta. */
+}
+.lnd-vmove-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  border-top: 1px solid var(--lnd-border-soft);
+  padding-top: 14px;
+  margin-top: auto;
+}
+.lnd-vmove-list li {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  font-size: 13.5px;
+  font-weight: 600;
+  color: var(--lnd-ink);
+}
+.lnd-vmove-list li svg {
+  flex: none;
+  margin-top: 2px;
+  color: var(--lnd-purple);
+}
+.lnd-vmove--soon {
+  background: var(--lnd-bg);
+}
+.lnd-vmove-tag {
+  align-self: flex-start;
+  font-family: var(--lnd-font-data);
+  font-size: 9.5px;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--lnd-warn);
+  background: var(--lnd-warn-soft);
+  border-radius: var(--lnd-r-pill);
+  padding: 3px 9px;
+}
+
+/* Abaixo de 900px duas colunas dariam ~370px por card — o card ainda
+   funciona, mas o parágrafo e a lista de 3 itens ficam apertados. Uma
+   coluna mantém a leitura confortável até o celular. */
+@media (max-width: 900px) {
+  .lnd-vmoves {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
