{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": ".rank-test-build",
    "rootDir": ".",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["node"]
  },
  "include": [
    "src/lib/gamification/momentum-core.ts",
    "src/lib/gamification/display-name-core.ts",
    "src/lib/gamification/xp.ts",
    "src/lib/gamification/db.ts",
    "src/lib/gamification/index.ts",
    "src/lib/ai/db.ts",
    "src/lib/publishing/db.ts",
    "src/types/prisma-shim.d.ts",
    "scripts/rank-tests.ts"
  ]
}
